{
  "name": "furniture-ai",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:mobile": "ng build",
    "mobile:sync": "npm run build:mobile && npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:run": "npm run build:mobile && npx cap run android",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:furniture-ai": "node dist/furniture-ai/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.23",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.23",
    "@angular/compiler": "^20.3.23",
    "@angular/core": "^20.3.23",
    "@angular/forms": "^20.3.23",
    "@angular/platform-browser": "^20.3.23",
    "@angular/platform-server": "^20.3.23",
    "@angular/router": "^20.3.23",
    "@angular/ssr": "^20.3.23",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@google/model-viewer": "^4.3.1",
    "@microsoft/signalr": "^10.0.0",
    "@primeuix/themes": "^3.0.0-alpha.11",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "three": "^0.184.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.23",
    "@angular/cli": "^20.3.23",
    "@angular/compiler-cli": "^20.3.23",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "@types/three": "^0.184.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
